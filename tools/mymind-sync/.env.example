# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Create an access key on https://access.mymind.com/extensions
# The key needs FULL ACCESS: the tool reads objects and writes the "shared" tag.

MYMIND_KEY_ID=
MYMIND_PRIVATE_KEY=

# Optional — defaults to https://api.mymind.com
# MYMIND_API_BASE_URL=https://api.mymind.com
